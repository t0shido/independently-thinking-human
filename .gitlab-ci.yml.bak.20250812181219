stages:
  - lint
  - test
  - build
  - deploy

variables:
  DOCKER_DRIVER: overlay2
  DOCKER_TLS_CERTDIR: ""
  FRONTEND_DIR: "."
  BACKEND_DIR: "django_backend"
  NODE_VERSION: "18"
  PYTHON_VERSION: "3.10"

# Cache dependencies between jobs
cache:
  key: ${CI_COMMIT_REF_SLUG}
  paths:
    - node_modules/
    - ${BACKEND_DIR}/venv/

# Frontend linting
frontend:lint:
  stage: lint
  image: node:${NODE_VERSION}
  script:
    - cd ${FRONTEND_DIR}
    - npm ci
    - npm run lint
  only:
    changes:
      - "*.js"
      - "*.jsx"
      - "*.json"
      - "src/**/*"
      - "public/**/*"
      - "package.json"
      - "package-lock.json"

# Backend linting
backend:lint:
  stage: lint
  image: python:${PYTHON_VERSION}
  script:
    - cd ${BACKEND_DIR}
    - pip install virtualenv
    - virtualenv venv
    - source venv/bin/activate
    - pip install -r requirements.txt
    - pip install flake8
    - flake8 .
  only:
    changes:
      - "${BACKEND_DIR}/**/*"
      - "${BACKEND_DIR}/requirements.txt"

# Frontend tests
frontend:test:
  stage: test
  image: node:${NODE_VERSION}
  script:
    - cd ${FRONTEND_DIR}
    - npm ci
    - npm test -- --passWithNoTests
  only:
    changes:
      - "*.js"
      - "*.jsx"
      - "src/**/*"
      - "package.json"
      - "package-lock.json"

# Backend tests
backend:test:
  stage: test
  image: python:${PYTHON_VERSION}
  services:
    - postgres:latest
  variables:
    POSTGRES_DB: test_db
    POSTGRES_USER: postgres
    POSTGRES_PASSWORD: postgres
    DATABASE_URL: "postgresql://postgres:postgres@postgres:5432/test_db"
  script:
    - cd ${BACKEND_DIR}
    - pip install virtualenv
    - virtualenv venv
    - source venv/bin/activate
    - pip install -r requirements.txt
    - python manage.py test
  only:
    changes:
      - "${BACKEND_DIR}/**/*"
      - "${BACKEND_DIR}/requirements.txt"

# Build frontend
frontend:build:
  stage: build
  image: node:${NODE_VERSION}
  script:
    - cd ${FRONTEND_DIR}
    - npm ci
    - npm run build
  artifacts:
    paths:
      - ${FRONTEND_DIR}/dist/
    expire_in: 1 week
  only:
    - main

# Build backend (collect static files, migrations)
backend:build:
  stage: build
  image: python:${PYTHON_VERSION}
  script:
    - cd ${BACKEND_DIR}
    - pip install virtualenv
    - virtualenv venv
    - source venv/bin/activate
    - pip install -r requirements.txt
    - python manage.py collectstatic --noinput
    - python manage.py check --deploy
  artifacts:
    paths:
      - ${BACKEND_DIR}/staticfiles/
    expire_in: 1 week
  only:
    - main

# Deploy to production
deploy:production:
  stage: deploy
  image: alpine:latest
  before_script:
    - apk add --no-cache openssh-client rsync
    - eval $(ssh-agent -s)
    - echo "$SSH_PRIVATE_KEY" | tr -d '\r' | ssh-add -
    - mkdir -p ~/.ssh
    - chmod 700 ~/.ssh
    - echo "$SSH_KNOWN_HOSTS" > ~/.ssh/known_hosts
    - chmod 644 ~/.ssh/known_hosts
  script:
    - echo "Deploying frontend (dist/) and Django backend to production server..."
    # Ensure target directories exist and ownership is sane
    - ssh $PRODUCTION_USER@$PRODUCTION_SERVER "sudo mkdir -p $PRODUCTION_PATH/django_backend/{staticfiles,media} $PRODUCTION_PATH/frontend_dist && sudo chown -R www-data:www-data $PRODUCTION_PATH/django_backend || true"
    # Sync frontend build to frontend_dist
    - rsync -az --delete ${FRONTEND_DIR}/dist/ $PRODUCTION_USER@$PRODUCTION_SERVER:$PRODUCTION_PATH/frontend_dist/
    # Sync backend code to django_backend
    - rsync -az --delete ${BACKEND_DIR}/ $PRODUCTION_USER@$PRODUCTION_SERVER:$PRODUCTION_PATH/django_backend/
    # Server-side: set up venv, install deps, collect static, migrate, restart services
    - |
      ssh $PRODUCTION_USER@$PRODUCTION_SERVER '
        set -e
        cd $PRODUCTION_PATH
        python3 -m venv venv || true
        source venv/bin/activate
        pip install --upgrade pip
        pip install -r $PRODUCTION_PATH/django_backend/requirements.txt
        cd $PRODUCTION_PATH/django_backend
        python manage.py collectstatic --noinput
        python manage.py migrate --noinput
        sudo systemctl restart gunicorn || sudo systemctl restart independently-thinking-human
        sudo systemctl reload nginx
      '
  environment:
    name: production
    url: https://independently-thinking-human.com
  only:
    - main
  when: manual
