# Django Environment Variables Template
# This file shows the required environment variables for production

# Django Core Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
DJANGO_ALLOWED_HOSTS=your-server-ip,your-domain.com

# Security Settings
CSRF_TRUSTED_ORIGINS=http://your-server-ip,https://your-domain.com

# Database Configuration (auto-generated during deployment)
DATABASE_URL=postgresql://username:password@localhost:5432/independently_thinking_human

# Media Settings
MEDIA_URL=/media/
